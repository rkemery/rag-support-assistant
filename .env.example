# Needed only for live runs (make judge-dev, make eval-live). Offline commands need nothing.
# Your Azure AI Foundry resource's OpenAI v1 endpoint, ending in /openai/v1/
AZURE_OPENAI_BASE_URL=
# Key auth. Leave empty to sign in with Entra ID (DefaultAzureCredential) instead.
AZURE_OPENAI_API_KEY=
# Entra ID scope, only if yours differs from the default.
# AZURE_OPENAI_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default
# Torch CPU threads for the offline model steps (default 2).
# RAG_TORCH_THREADS=2
